/// Объект на карте: пещерный город, каньон, плато, дворец, водопад.
///
/// Задача E1. Справочник на 780 страниц живёт в модели `Post` вперемешку
/// со статьями, и из-за этого «Мангуп-Кале» на сайте — это статья, а не
/// сущность: к ней нельзя привязать туры, нельзя посчитать расстояние до
/// города, нельзя построить перелинковку иначе как руками. Ровно поэтому
/// 780 из 868 адресов лежат в корне одним уровнем и никуда не ведут.
///
/// Place — это механизм, превращающий справочник в воронку: у объекта есть
/// координаты и связь с турами, которые сюда заезжают.
///
/// Со статьёй справочника объект связан один к одному (`postId`), а не
/// заменяет её: текст, возраст и накопленные ссылки остаются на прежнем
/// адресе `/{slug}`, а страница объекта `/mesta/{slug}` — это карточка
/// с турами. Какой из двух адресов станет каноническим по объекту,
/// решается в B6 по позициям, и модель этому решению не мешает.
model Place {
  id Int @id @default(autoincrement())

  /// Адрес страницы: /mesta/{slug}.
  slug String @unique @db.VarChar(200)

  title String @db.VarChar(180)

  /// Короткое описание для карточки и мета-тега.
  description String? @db.VarChar(512)

  /// Собственный текст страницы объекта. Может пустовать: тогда
  /// содержимое берётся из связанной статьи.
  content String?

  /// Координаты — ради `TouristAttraction` в разметке (C5) и расчёта
  /// «что рядом» в перелинковке (E7). Nullable: часть объектов
  /// заводится до того, как координаты уточнены, а выдуманные
  /// координаты в разметке хуже отсутствующих.
  latitude  Float?
  longitude Float?

  /// Ближайший город — ось гео-страниц (E3) и связок «откуда → куда» (E4).
  city String? @db.VarChar(120)

  /// Тот же город ключом. Строка выше остаётся до задачи 1-К
  /// (expand-contract, см. `docs/deploy/migrations.md`).
  cityId  Int?  @map("city_id")
  cityRef City? @relation(fields: [cityId], references: [id], onDelete: SetNull)

  /// Район или городской округ: «Бахчисарайский район».
  district String? @db.VarChar(120)

  /// Тип объекта: пещерный город, каньон, плато, дворец, водопад.
  /// Строкой, а не enum, — по той же причине, что и сложность тура.
  kind String? @db.VarChar(80)

  mainImage String? @map("main_image") @db.VarChar(512)

  /// Статья справочника об этом объекте, если она есть.
  postId Int? @unique @map("post_id")

  /// Показывать ли объект в разделе и sitemap.
  isPublished Boolean @default(false) @map("is_published")

  tours TourPlace[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp()

  @@index([city])
  @@index([cityId])
  @@index([isPublished])
  @@map("place")
}

/// Связь «тур ↔ объект».
///
/// Явная таблица, а не неявная many-to-many: у связи есть собственные
/// данные — порядок объекта в маршруте. Без порядка блок «маршрут»
/// на карточке тура пришлось бы строить по алфавиту.
model TourPlace {
  tourId  Int   @map("tour_id")
  tour    Tour  @relation(fields: [tourId], references: [id], onDelete: Cascade)
  placeId Int   @map("place_id")
  place   Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  /// Номер остановки в маршруте.
  position Int @default(0)

  @@id([tourId, placeId])
  @@index([placeId])
  @@map("tour_place")
}
