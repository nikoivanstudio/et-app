/// Город: ось, по которой туры делятся между собой и по которой строятся
/// гео-страницы.
///
/// До этого города не было как сущности: у тура лежала строка `start_city`,
/// у объекта — `city`, у гида — `city`, и заполнялись все три свободным
/// вводом. Пока гид один, это незаметно; на втором гиде «Ялта», «г. Ялта»
/// и «ялта» становятся тремя разными городами для любого `where`, и каталог
/// расходится молча — без ошибки, просто половина туров перестаёт попадать
/// в подборки.
///
/// Заводится таблицей, а не константой в коде (в отличие от региона): на
/// город ссылаются туры, объекты и профили гидов, а значит нужен внешний
/// ключ. Регион же задаёт устройство адресов и навигации, нужен на сборке
/// и потому живёт кодом — см. `src/entities/region/constants/regions.ts`
/// и `docs/geo/plan.md`.
model City {
  id Int @id @default(autoincrement())

  /// Последний сегмент адреса гео-страницы: `/dzhip-tury/{slug}`.
  /// Совпадает со слагом посадочной, если она заведена.
  ///
  /// Уникален по всему справочнику, а не в пределах региона: слаг —
  /// это то, что приходит из формы и лежит в реестре посадочных, и там
  /// он без региона. Уникальность в паре с регионом означала бы, что
  /// один и тот же `yalta` разрешается в разные города в зависимости от
  /// того, какая строка нашлась первой. Одноимённые города в разных
  /// регионах разводятся слагом (`staryy-krym-altay`), а не молчаливой
  /// неоднозначностью.
  slug String @unique @db.VarChar(120)

  title String @db.VarChar(120)

  /// Слаг региона из реестра `src/entities/region`. Строкой, а не связью:
  /// таблицы регионов нет намеренно. Согласованность проверяет тест
  /// `region-registry.test.ts`, а не внешний ключ.
  regionSlug String @map("region_slug") @db.VarChar(60)

  /// Координаты — для расчёта «что рядом» (E7) и разметки. Пустуют:
  /// выдуманные координаты в разметке хуже отсутствующих, то же правило,
  /// что у `Place`.
  latitude  Float?
  longitude Float?

  /// Показывать ли город в выборе гида и в подборках.
  isPublished Boolean @default(true) @map("is_published")

  /// Порядок в списках. По алфавиту Бахчисарай оказывается впереди
  /// Симферополя, а в выборе гида сверху должны стоять города,
  /// из которых выезжают чаще.
  position Int @default(0)

  startedTours Tour[]           @relation("TourStartCity")
  pickupTours  TourPickupCity[]
  places       Place[]
  guides       User[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp()

  @@index([regionSlug])
  @@map("city")
}

/// Связь «тур ↔ город, откуда гид готов забрать группу».
///
/// Явная таблица вместо прежнего массива строк `tour.pickup_cities`:
/// по этим городам строятся подборки «джип-туры из …», то есть по ним
/// идёт выборка, а выборка по массиву строк со свободным вводом
/// не сходится ровно так же, как по `start_city`.
model TourPickupCity {
  tourId Int  @map("tour_id")
  tour   Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  cityId Int  @map("city_id")
  city   City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([tourId, cityId])
  @@index([cityId])
  @@map("tour_pickup_city")
}
