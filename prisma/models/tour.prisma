model Tour {
  id               Int        @id @default(autoincrement())
  title            String     @db.VarChar(180)
  description      String
  /// Главное фото. Необязательное: черновик заводится на первом шаге
  /// редактора, когда фотографий ещё нет, а публичной страницы у него
  /// не будет до одобрения (status = APPROVED).
  mainPhotoId      Int?       @map("main_photo_id")
  price            Int
  duration         Int
  content          Json       @map("content")
  slug             String     @unique
  categories       String[]
  metaKeywords     String[]   @map("meta_keywords")
  tags             String[]
  tourRoute        Json[]     @map("tour_route")
  authorId         Int        @map("author_id")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamp()
  author           User       @relation(fields: [authorId], references: [id])
  reviews          Review[]
  activities       Activity[]
  orders           Order[]
  bookings         Booking[]
  photos           Photo[]
  about            String?    @db.VarChar(512)
  status           String?
  rejectionComment String?    @map("rejection_comment")
  metaTitle        String?    @map("meta_title")
  metaDescription  String?    @map("meta_description")
  updatedAt        DateTime?  @updatedAt @map("updated_at") @db.Timestamp()
  rating           Float?
  descriptionText  String?    @map("description_text")
  startPlace       Json?      @map("start_place")

  // --- A3. Поля, без которых не собрать ни карточку, ни разметку ---------
  //
  // В модели уже были цена, длительность, маршрут, точка старта и рейтинг.
  // Не хватало ровно того, что спрашивают перед заявкой и чего требует
  // schema.org для расширенного сниппета.

  /// Что входит в цену: аренда авто, топливо, услуги водителя, сборы.
  /// Массив, а не текст: этот список рендерится отдельным блоком и
  /// попадает в разметку, а из абзаца его не достать.
  included String[] @default([])

  /// Что НЕ входит: входные билеты, обед, страховка. Отдельным полем,
  /// потому что на карточке Чуфут-Кале это было спрятано в текст —
  /// и оттуда же пришли билеты «на 1 мая 2018 года» (A8).
  excluded String[] @default([])

  /// Сколько человек берёт машина. Главный вопрос на входящем звонке.
  capacity Int?

  /// Сложность: EASY | MEDIUM | HARD. Строкой, а не enum: набор уровней
  /// в нише не устоялся, а миграция enum в Postgres дороже, чем проверка
  /// в zod-схеме формы.
  difficulty String? @db.VarChar(20)

  /// Вопросы и ответы: [{ question, answer }]. Источник для FAQPage (C4).
  /// jsonb, а не отдельная таблица: список правится целиком вместе с туром
  /// и никогда не запрашивается отдельно от него.
  faq Json?

  /// Месяцы, когда тур идёт: [4, 5, 6 …]. Пустой массив — круглый год.
  /// Зимой половина маршрутов на плато недоступна, и показывать их
  /// в декабре — гарантированная несостоявшаяся заявка.
  seasons Int[] @default([])

  /// За что цена: PER_CAR | PER_PERSON. Без этого поля число в `price`
  /// нельзя ни показать честно, ни положить в Offer: на легаси-страницах
  /// «от 8 000 ₽» и «2000 рублей за автомобиль» стояли рядом.
  priceUnit String? @map("price_unit") @db.VarChar(20)

  /// Город выезда — отдельным полем, а не внутри startPlace: по нему
  /// строятся гео-страницы `/dzhip-tury/{gorod}` (E3) и связки
  /// «откуда → куда» (E4), а координаты для группировки не годятся.
  startCity String? @map("start_city") @db.VarChar(120)

  /// Город выезда ключом — то, по чему идёт выборка.
  ///
  /// Строка выше осталась и продолжает заполняться: удалить колонку в том же
  /// деплое нельзя (expand-contract, см. `docs/deploy/migrations.md`), а после
  /// выкладки она становится денормализованным названием — его пишет тот же
  /// код, что и ключ, и берёт из справочника. Удаляется задачей 1-К.
  startCityId  Int?  @map("start_city_id")
  startCityRef City? @relation("TourStartCity", fields: [startCityId], references: [id], onDelete: SetNull)

  /// Объекты, которые тур посещает. Связь, ради которой заведена
  /// модель Place: из неё строятся и блок «туры сюда» (E2),
  /// и перелинковка по правилам (E7).
  places TourPlace[]

  // --- Кабинет гида: расписание, варианты цен и место встречи --------------
  //
  // Шаги 3, 4 и 6 редактора тура (docs/design/canvas, артборд
  // GuideTourSchedule). До этого гид мог задать только одну цену и ничего —
  // про расписание: «во сколько выезжаем» и «в эти дни не берём» жили
  // в переписке, а не в туре.

  /// Варианты билетов: [{ label, unit, durationHours, price }].
  /// jsonb, а не таблица: список правится целиком вместе с туром и никогда
  /// не запрашивается отдельно от него — как faq и tourRoute рядом.
  /// Поле `price` в модели остаётся базовым: по нему сортируется каталог.
  priceOptions Json? @map("price_options")

  /// Со скольких человек выезд состоится. Без него гид отменяет заявку
  /// на двоих уже после подтверждения.
  minGroupSize Int? @map("min_group_size")

  /// За сколько дней до выезда перестаём принимать заявки.
  bookingLeadDays Int? @map("booking_lead_days")

  /// Обычное время старта, «08:00». Строкой, а не DateTime: это время суток
  /// без даты, и в заявке оно всё равно показывается текстом.
  startTime String? @map("start_time") @db.VarChar(5)

  /// Дни недели, когда тур идёт: 1 — понедельник, 7 — воскресенье.
  /// Пустой массив — любой день.
  weekdays Int[] @default([])

  /// Даты, закрытые гидом вручную. Занятые выезды сюда не попадают —
  /// они и так считаются по подтверждённым заявкам (booking.desiredDate).
  blockedDates DateTime[] @default([]) @map("blocked_dates")

  /// Адрес места встречи. Город лежит в startCity, координаты — в startPlace,
  /// а строку «ул. Московская, 8, автовокзал» негде было хранить.
  meetingAddress String? @map("meeting_address") @db.VarChar(300)

  /// Как добраться до места встречи и по какому ориентиру искать гида.
  meetingNote String? @map("meeting_note") @db.VarChar(1000)

  /// Города, из которых гид готов забрать группу. Из них же строятся
  /// подборки «джип-туры из …» (E3), поэтому это список, а не текст.
  pickupCities String[] @default([]) @map("pickup_cities")

  /// Те же города ключами. Причина та же, что у `startCityId`: по городам
  /// подбора идёт выборка, а выборка по массиву строк не сходится.
  pickupCityLinks TourPickupCity[]

  @@index([startCityId])
  @@map("tour")
}
