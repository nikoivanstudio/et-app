model Tour {
  id              Int        @id @default(autoincrement())
  title           String     @db.VarChar(180)
  description     String
  mainPhotoId     Int        @map("main_photo_id")
  price           Int
  duration        Int
  content         Json       @map("content")
  slug            String     @unique
  categories      String[]
  metaKeywords    String[]   @map("meta_keywords")
  tags            String[]
  tourRoute       Json[]     @map("tour_route")
  authorId        Int        @map("author_id")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamp()
  author          User       @relation(fields: [authorId], references: [id])
  reviews         Review[]
  activities      Activity[]
  orders          Order[]
  photos          Photo[]
  about           String?   @db.VarChar(512)
  status          String?
  metaTitle       String?    @map("meta_title")
  metaDescription String?    @map("meta_description")
  updatedAt       DateTime?  @updatedAt @map("updated_at") @db.Timestamp()
  rating          Float?
  descriptionText String?    @map("description_text")
  startPlace      Json?      @map("start_place")

  @@map("tour")
}
