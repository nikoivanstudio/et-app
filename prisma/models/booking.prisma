model Booking {
  id            Int       @id @default(autoincrement())
  tourId        Int       @map("tour_id")
  tour          Tour      @relation(fields: [tourId], references: [id])
  guideId       Int       @map("guide_id")
  guide         User      @relation("GuideBookings", fields: [guideId], references: [id])
  clientUserId  Int?      @map("client_user_id")
  client        User?     @relation("ClientBookings", fields: [clientUserId], references: [id])
  guestName     String    @map("guest_name") @db.VarChar(120)
  guestPhone    String    @map("guest_phone") @db.VarChar(40)
  guestEmail    String?   @map("guest_email")
  desiredDate   DateTime? @map("desired_date")
  peopleCount   Int       @default(1) @map("people_count")
  comment       String?   @db.VarChar(1000)
  status        String    @default("NEW") @db.VarChar(40)
  accessToken   String    @unique @map("access_token")
  cancelReason  String?   @map("cancel_reason") @db.VarChar(500)
  guideNote     String?   @map("guide_note") @db.VarChar(1000)
  statusHistory Json      @default("[]") @map("status_history")
  messages      Message[]
  phoneVerified Boolean   @default(false) @map("phone_verified")

  /// Когда стороне в последний раз уходило письмо о новом сообщении.
  /// Нужны обе отметки: переписка двусторонняя, а письма считаются
  /// по каждому направлению отдельно (см. booking-mailer).
  clientNotifiedAt DateTime? @map("client_notified_at") @db.Timestamp()
  guideNotifiedAt  DateTime? @map("guide_notified_at") @db.Timestamp()
  processedAt      DateTime? @map("processed_at") @db.Timestamp()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamp()

  @@index([guideId, status])
  @@map("booking")
}
