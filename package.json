{
  "name": "et-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --fix",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:reset": "npx prisma migrate reset",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "prettier": "prettier -w .",
    "test": "jest --testMatch='**/*.test.ts'",
    "test:components": "jest --testMatch='**/*.test.tsx'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:seo": "jest --testMatch='**/{metadata,indexing,sitemap,json-ld,description,breadcrumbs,organization,content-images}.test.ts'",
    "seo:check-sitemap": "tsx scripts/check-sitemap-urls.ts",
    "seo:check-duplicates": "tsx scripts/check-duplicates.ts",
    "geo:check-cities": "tsx scripts/check-city-links.ts",
    "rewrite:queue": "tsx prisma/scripts/rewrite-queue.ts",
    "rewrite:apply": "tsx prisma/scripts/apply-rewrite.ts",
    "perf:web-vitals": "playwright test tests/web-vitals.spec.ts --project=chromium",
    "test:bdd": "bddgen --config playwright.bdd.config.ts && playwright test --config playwright.bdd.config.ts",
    "test:bdd:ui": "bddgen --config playwright.bdd.config.ts && playwright test --config playwright.bdd.config.ts --ui"
  },
  "dependencies": {
    "@bem-react/classname": "^1.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-email/render": "^2.1.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "minio": "^8.0.7",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "next-turnstile": "^1.0.7",
    "numeralize-ru": "^2.0.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "resend": "^6.28.1",
    "sanitize-html": "^2.17.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "test-exclude": "^8.0.0",
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  }
}
