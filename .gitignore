# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
migration.json

# testing
/coverage

# next.js
/.next/
# Сборки в отдельный каталог (NEXT_DIST_DIR): Tailwind сканирует всё, что не
# в .gitignore, и спотыкается о бинарные кэши turbopack внутри них.
/.next-*/
/out/

# production
/build
# `/public` тут был от Create React App, где это сборка. В Next это
# исходники: всё, что лежит здесь, отдаётся по стабильному адресу без
# хеша — favicon, robots-файлы, логотип для разметки организации (C1).
# Пока каталог игнорировался, положить в него файл было некуда: он
# не уезжал на прод, и абсолютной ссылки на логотип не существовало.

# misc
.DS_Store
*.pem
*.idea

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
tasks.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# playwright-bdd (генерируемые из .feature тесты)
/.features-gen/

# Author
delolopment-plan.md
wp-base.json

# Claude Code / agent
.claude/
# temp dir from local scripting (dev server log, scratch files)
.tmp-tri/

# Документация и рабочие материалы — не в гит
/docs/
