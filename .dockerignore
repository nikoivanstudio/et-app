# HIGH-5: без этого файла COPY . . переносил в образ секреты и лишние данные

# секреты — главная причина появления этого файла
.env
.env.*
*.pem

# служебное
.git
.gitignore
.github
.gitlab-ci.yml
node_modules
.next
out
build
coverage
.swc
*.tsbuildinfo

# тесты и отчёты
# ВАЖНО: co-located тесты (src/**/*.test.ts) тоже исключаются — иначе `next build`
# в образе проверяет их типы, а jest.setup.ts (который подтягивал типы jest
# через @testing-library/jest-dom) в образ не попадает, и сборка падает.
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
tests
tests-examples
test-results
playwright-report
.features-gen
playwright.config.ts
playwright.bdd.config.ts
jest.config.ts
jest.setup.ts

# локальное окружение разработчика
.idea
.vscode
.claude
.DS_Store
.tmp-tri
docs
plan.zip
migration.json
tasks.md
